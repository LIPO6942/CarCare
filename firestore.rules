rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur connecté est bien le propriétaire de la donnée
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. Véhicules
    match /vehicles/{vehicleId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 2. Entretiens (Maintenance)
    match /maintenance/{maintenanceId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 3. Réparations
    match /repairs/{repairId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 4. Pleins de carburant
    match /fuelLogs/{fuelLogId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 5. Diagnostics IA
    match /aiDiagnostics/{diagId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 6. Lieux enregistrés
    match /places/{placeId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // 7. Tokens de notification FCM (ESSENTIEL pour débloquer les rappels)
    match /fcmTokens/{tokenId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }
  }
}
